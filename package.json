{
  "name": "@ominity/next",
  "version": "1.9.2",
  "description": "Headless Next.js integration layer for Ominity applications and storefronts.",
  "homepage": "https://github.com/ominity/next#readme",
  "bugs": {
    "url": "https://github.com/ominity/next/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ominity/next.git"
  },
  "license": "BSD-2-Clause",
  "author": "Ominity",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cms": {
      "types": "./dist/cms/index.d.ts",
      "default": "./dist/cms/index.js"
    },
    "./cms/rendering": {
      "types": "./dist/cms/rendering/index.d.ts",
      "default": "./dist/cms/rendering/index.js"
    },

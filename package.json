  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "next-intl": "^4.11.1"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node scripts/generate-package-info.mjs && pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "pnpm build && node --test tests/**/*.test.mjs",
    "prepublishOnly": "pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@ominity/api-typescript": "^1.4.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "next": "^16.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.56.4",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependencies": {
    "@ominity/api-typescript": "^1.4.6",
    "next": "^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  }

    "./customer-accounts/server": {
      "types": "./dist/customer-accounts/server/index.d.ts",
      "default": "./dist/customer-accounts/server/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./dist/actions/index.js"
    },
    "./actions/react": {
      "types": "./dist/actions/react.d.ts",
      "default": "./dist/actions/react.js"
